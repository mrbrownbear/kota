e also set up Google Analytics and Tag Manager to track site performance and ensure continuous improvement.\u003c/p\u003e\\n\u003cp\u003e\u003c!-- notionvc: 82b55fa3-3e57-43ad-8fc3-c092de9d3cfc --\u003e\u003c/p\u003e\\n\"}}]}]}],null]}]}],[\"$\",\"section\",null,{\"className\":\"SingleImage_singleImage__NY3zv\",\"data-margin\":\"default\",\"children\":[\"$\",\"$L2e\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"SingleImage_containedImage__N2jLD\",\"children\":[\"$\",\"$L2a\",null,{\"image\":{\"altText\":\"\",\"srcSet\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Colours-1400x788.png 1400w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Colours-2000x1125.png 2000w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Colours-500x281.png 500w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Colours-768x432.png 768w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Colours-1536x864.png 1536w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Colours-2048x1152.png 2048w\",\"sourceUrl\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Colours.png\",\"mediaDetails\":{\"width\":2448,\"height\":1377}}}]}]}],false]}]}],[\"$\",\"section\",null,{\"className\":\"$undefined\",\"data-margin\":\"default\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"SingleImage_containedImage__N2jLD\",\"children\":[\"$\",\"$L2d\",null,{\"data\":{\"__typename\":\"Project_Singleproject_ContentBuilder_SingleVideo\",\"fieldGroupName\":\"Project_Singleproject_ContentBuilder_SingleVideo\",\"alignment\":\"contained\",\"marginBottom\":\"default\",\"loop\":{\"mediaItemUrl\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/isi-vid4.mp4\"},\"fullVideo\":null}}]}]}],false]}],[\"$\",\"section\",nu