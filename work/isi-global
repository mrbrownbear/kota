d engaging path that complements the content.\u003c/p\u003e\\n\u003cp\u003e\u003c!-- notionvc: bcc89585-f817-484b-b722-9d6a2e34809f --\u003e\u003c/p\u003e\\n\"}}]}]}],null]}]}],[\"$\",\"section\",null,{\"className\":\"MediaGallery_mediaGallery__vB7wJ \",\"data-margin\":\"default\",\"style\":{\"backgroundColor\":\"transparent\"},\"children\":[\"$\",\"$L2f\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"MediaGallery_grid___30fo MediaGallery_layout6__wJx6J\",\"children\":[[\"$\",\"div\",null,{\"className\":\"MediaGallery_media1__9Ryxs\",\"data-animation\":\"grid-item\",\"children\":[false,[\"$\",\"$L30\",null,{\"src\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/isi-vid1-1.mp4\",\"layout\":\"intrinsic\"}]]}],[\"$\",\"div\",null,{\"className\":\"MediaGallery_media2__Uc1vY\",\"data-animation\":\"grid-item\",\"children\":[[\"$\",\"$L2a\",null,{\"image\":{\"altText\":\"\",\"srcSet\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col.png 1188w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col-431x500.png 431w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col-768x891.png 768w\",\"sourceUrl\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col.png\",\"mediaDetails\":{\"width\":1188,\"height\":1378}},\"layout\":\"intrinsic\"}],false]}],[\"$\",\"div\",null,{\"className\":\"MediaGallery_media3__rEmNG\",\"data-animation\":\"grid-item\",\"children\":[[\"$\",\"$L2a\",null,{\"image\":{\"altText\":\"\",\"srcSet\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col-1.png 1190w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col-1-432x500.png 432w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col-1-768x889.png 768w\",\"sourceUrl\":\"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2025/02/Col-1.png\",\"media