"BigUps_logo__sSEo5","children":["$","img",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/mindsparkle.svg","alt":""}]}],["$","div",null,{"className":"BigUps_nameType__Ysghr","children":[["$","p",null,{"className":"BigUps_name__ntnRC","children":"Mindsparkle Mag"}],["$","p",null,{"className":"BigUps_type__sHqdy","children":"Site of the day"}]]}],["$","p",null,{"className":"BigUps_amount__Xk995","children":["x ",2]}]]}]}],["$","$L27","2",{"children":["$","div","2",{"className":"BigUps_award__D7Yq2","children":[["$","figure",null,{"className":"BigUps_logo__sSEo5","children":["$","img",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/cssda.svg","alt":""}]}],["$","div",null,{"className":"BigUps_nameType__Ysghr","children":[["$","p",null,{"className":"BigUps_name__ntnRC","children":"CSS Design Awards"}],["$","p",null,{"className":"BigUps_type__sHqdy","children":"Special Kudos"}]]}],["$","p",null,{"className":"BigUps_amount__Xk995","children":["x ",3]}]]}]}],["$","$L27","3",{"children":["$","div","3",{"className":"BigUps_award__D7Yq2","children":[["$","figure",null,{"className":"BigUps_logo__sSEo5","children":["$","img",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/Path-1345.svg","alt":""}]}],["$","div",null,{"className":"BigUps_nameType__Ysghr","children":[["$","p",null,{"className":"BigUps_name__ntnRC","children":"FWA"}],["$","p",null,{"className":"BigUps_type__sHqdy","children":"Site of the day"}]]}],["$","p",null,{"className":"BigUps_amount__Xk995","children":["x ",1]}]]}]}],["$","$L27","4",{"children":["$","div","4",{"className":"BigUps_award__D7Yq2","children":[["$","figure",null,{"className":"BigUps_logo__sSEo5","children":["$","img",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2025/11/The-Lovies-4.png","alt":""}]}],["$","div",null,{"className":"BigUps_nameType__Ysghr","children":[["$","p",null,{"className":"BigUps_name__ntnRC","children":"The Lovies"}],["$","p",null,{"className":"BigUps_type__sHqdy","children":"Best Web Design - Aesthetic"}]]}],["$","p",null,{"className":"BigUps_amount__Xk995","children":["x ",1]}]]}]}]]}]]}]]}],["$","$L29",null,{"data":{"intro":"<p>We're proud to be a Certified Great Place to Work®! You'll find us working across Creative Web Design, Web Development, Branding, and Digital Marketing. </p>\n","team":[{"bio":"<p>Matt is a designer specialising in digital experiences, with a focus on animated and interactive content. It was at Southampton University where he developed his skills in interface design, whilst specialising in motion graphics. If he isn’t sat at his computer, you’ll most likely find him either playing footie or watching his beloved Chelsea.</p>\n","name":"Matt","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-matt-1.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-matt-1-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-matt-1-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-matt-1.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Senior Designer","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/matt-fun.jpg 800w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/matt-fun-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/matt-fun-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/matt-fun.jpg","mediaDetails":{"width":800,"height":800}}},{"bio":"<p>Nicola is a designer with a background in fashion design and has worked for premium brands that took her all over the world. After a decade of working in fashion, she followed her creative curiosity and changed careers to become a graphic designer. She has a love for branding, digital design and karaoke - Shania Twain is her go-to. </p>\n","name":"Nicola","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-nicola2-1.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-nicola2-1-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-nicola2-1-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-nicola2-1.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Designer","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/nicola-fun.jpg 800w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/nicola-fun-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/nicola-fun-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/nicola-fun.jpg","mediaDetails":{"width":800,"height":800}}},{"bio":"<p>James is a designer and art director specialising in interactive design and branding. He's passionate about elegant design solutions and beautifully realised creative ideas. James has spent over a decade working in big and small agencies, both full time and as a freelancer. He’s as comfortable solving complex UX problems for digital products as he is dreaming up surreal artwork for big brands.</p>\n","name":"James","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-huse.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-huse-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-huse-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-huse.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Head of Design","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/huse-fun.jpg 800w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/huse-fun-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/huse-fun-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/huse-fun.jpg","mediaDetails":{"width":800,"height":800}}},{"bio":"<p>Bekah is a front-end developer, and a big advocate for accessibility and performance on the web. With a previous career in events management, Bekah has a keen eye for detail and takes pride in crafting a polished user experience.<br />\nWhen she’s not writing code, Bekah loves to travel and play video games, and one day plans to live up to her namesake and buy a farm. (E-I-E-I-O)</p>\n","name":"Bekah","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-bekah.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-bekah-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-bekah-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-bekah.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Senior Developer","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/bekah-fun.jpg 800w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/bekah-fun-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/bekah-fun-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/bekah-fun.jpg","mediaDetails":{"width":800,"height":800}}},{"bio":"<p>Having spent nearly a decade working as an interior designer, Margo swapped the proverbial paint brush for a pen and decided to become a graphic designer. She lives in Slovenia, where she takes an interest in art, nature and of course, design.</p>\n","name":"Margo","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-margo.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-margo-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-margo-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-margo.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Designer","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/margo-fun.jpg 800w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/margo-fun-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/margo-fun-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/margo-fun.jpg","mediaDetails":{"width":800,"height":800}}},{"bio":"<p>Julian is a digital designer specialising in crafting immersive digital experiences and branding, with experience in animation and 3D. When he's not designing, you'll find him playing guitar, creating at the pottery studio, or, more often than not, watching Manchester United play—doing his best to hold back the tears.</p>\n","name":"Julian","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-filtered.png 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-filtered-368x500.png 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-filtered-768x1044.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-filtered.png","mediaDetails":{"width":1008,"height":1370}},"title":"Designer","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-image-2.png 1080w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-image-2-500x500.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-image-2-768x768.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Jules-image-2.png","mediaDetails":{"width":1080,"height":1080}}},{"bio":"<p>Avid Cambridge supporter and Co-Founder of KOTA.</p>\n<p>Having left school at the wee age of 16, Jonny quickly discovered his calling as a Developer. A self-proclaimed 'Dogsbody', he is the glue that holds KOTA together, linking the clients, development, marketing and design teams. His knowledge and experience comes from working with some of the most respected brands in the world, including Apple, Google, YouTube and Unilever.</p>\n","name":"Jonny","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-jonny.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-jonny-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-jonny-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-jonny.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Managing Director","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/jonny-fun.jpg 800w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/jonny-fun-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/jonny-fun-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/jonny-fun.jpg","mediaDetails":{"width":800,"height":800}}},{"bio":"<p>Based in Greece, Alex took an interest in web development when he was young and has passionately pursued it ever since. He’s a big fan of video games, watches and building computers from scratch.</p>\n","name":"Alex","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-alex.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-alex-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-alex-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-alex.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Developer","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/alex-fun.jpg 800w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/alex-fun-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/alex-fun-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/alex-fun.jpg","mediaDetails":{"width":800,"height":800}}},{"bio":"<p>Rachel is a creative project manager, supporting designers and developers to deliver beautiful work they can be proud of. With a background in graphic design and account management, she helps clients to feel completely at ease and in control. When she’s not crunching timelines, she’s probably outside birdwatching or knitting a new jumper.</p>\n","name":"Rachel","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-portrait.jpg 1000w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-portrait-363x500.jpg 363w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-portrait-768x1057.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-portrait.jpg","mediaDetails":{"width":1000,"height":1376}},"title":"Project Manager","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-square.jpg 1000w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-square-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-square-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Rachel-square.jpg","mediaDetails":{"width":1000,"height":1000}}},{"bio":"<p>A true organisation freak, Maja makes sure everything runs smoothly in the KOTA studio. Bringing her experience from Poland and France, where she's worked on the biggest international accounts, she keeps communication flowing throughout the team and for our clients. Being a proud 'crazy dog lady' you will most probably find her walking around London with her adorable French Bulldog under her arm.</p>\n","name":"Maja","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-maja.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-maja-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-maja-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-maja.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Head of Projects","secondaryPhoto":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/maja-fun.jpg","mediaDetails":{"width":487,"height":487}}},{"bio":"<p>With a degree in digital design & management, you name it, Ash has probably dabbled in it. With a specific interest in App design and development, she's always trying to learn the next new thing. When she's not managing our SiteCare clients, Ash can be found at her nearest Yoga studio, teaching yoga and meditation classes. She's our queen of zen!</p>\n","name":"Ashlee","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-Filtered.png 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-Filtered-368x500.png 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-Filtered-768x1044.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-Filtered.png","mediaDetails":{"width":1008,"height":1370}},"title":"Project Manager","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-image-2.png 1080w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-image-2-500x500.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-image-2-768x768.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/11/Ash-image-2.png","mediaDetails":{"width":1080,"height":1080}}},{"bio":"<p>Nick is a Strategy Director with 10+ years experience leading brand projects for clients, agencies, and VCs. He’s helped hundreds of companies launch, scale and reposition their brands, bringing a pragmatic, no-nonsense approach that helps leaders prioritise what matters and delivers clear, actionable work teams actually use.</p>\n","name":"Nick","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-1017x1400.jpg 1017w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-1453x2000.jpg 1453w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-363x500.jpg 363w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-768x1057.jpg 768w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-1116x1536.jpg 1116w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-1488x2048.jpg 1488w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-1860x2560.jpg 1860w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait.jpg 2000w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Nick-portrait-1860x2560.jpg","mediaDetails":{"width":2000,"height":2752}},"title":"Strategy Director","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/20180602_210444-1400x1050.jpg 1400w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/20180602_210444-2000x1500.jpg 2000w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/20180602_210444-500x375.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/20180602_210444-768x576.jpg 768w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/20180602_210444-1536x1152.jpg 1536w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/20180602_210444-2048x1536.jpg 2048w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/20180602_210444-2560x1920.jpg","mediaDetails":{"width":3000,"height":2250}}},{"bio":"<p>Adhi is a graphic designer with a background in branding, having worked on visual identity systems for global brands across Asia. At KOTA, he focuses on bringing brands to life digitally while maintaining the principles of visual communication. He has a soft spot for the finer details—especially well-designed subway maps—and when he’s away from his screen, you’ll usually find him enjoying nature or saying hello to a four-legged furry friend.</p>\n","name":"Adhi","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-1017x1400.jpg 1017w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-1453x2000.jpg 1453w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-363x500.jpg 363w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-768x1057.jpg 768w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-1116x1536.jpg 1116w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-1488x2048.jpg 1488w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-1860x2560.jpg 1860w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait.jpg 2000w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-portrait-1860x2560.jpg","mediaDetails":{"width":2000,"height":2752}},"title":"Designer","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-2.png 896w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-2-500x500.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-2-768x768.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2026/07/Adhi-2.png","mediaDetails":{"width":896,"height":896}}},{"bio":"<p>James fell in love with design when he was 17. </p>\n<p>After a stint at college where he mostly learnt that college wasn’t for him, he busked his way into the industry and had eight great years as a freelance graphic designer contracting for some of the biggest agencies in London before setting up KOTA with Jonny Bradford in 2012.</p>\n","name":"Piper","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Creative Director","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper2.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper2-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper2-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-piper2.jpg","mediaDetails":{"width":1008,"height":1008}}},{"bio":"<p>A former bad-ass designer, KOTA director and ex-rock and roll star. Ed is an extremely talented Graphic Designer whose love for art and design came from his younger years collecting vinyl for their fancy sleeves. Years later, after being inspired by his art teacher (big-ups Mr Pinnock), Ed graduated from the University of the Arts London (LCC) and then worked in a few different industries including post production TV, managing businesses in the Hospitality industry, and of course music.</p>\n<p>After joining forces with James and Jonny in 2013, he has helped shape the company as it is today with a mixture of creative flair, organisation, business strategy and team management. </p>\n","name":"Ed","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-ed.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-ed-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-ed-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-ed.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Operations Director","secondaryPhoto":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/ed-fun2.jpg","mediaDetails":{"width":500,"height":500}}},{"bio":"<p>Having worked in mostly music-based roles previously, Em comes from a creative background, specialising in key accounts management and international music education. After qualifying as a PRINCE2 practitioner, she decided to combine her loves of creativity, organisation (and spreadsheets!) and take on the role of project manager.</p>\n","name":"Em","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-em.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-em-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-em-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-em.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Project Manager","secondaryPhoto":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/em-fun2.jpg","mediaDetails":{"width":400,"height":400}}},{"bio":"<p>With a backgound in Literature and over eight years of mastering copywriting, marketing, and brand leadership, Emily has become the Swiss-Army knife of creative agency marketing.</p>\n<p>When she's not coaxing the personality out of brands or conjuring up inventive strategies, Emily's passion for film takes over. She edits a horror film zine and is our resident Alien franchise expert, always ready to dish out useless trivia, unprompted.</p>\n","name":"Emily","photo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/03/team-emily3.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/03/team-emily3-368x500.jpg 368w, /__external__/kota-content.b-cdn.net/app/uploads/2024/03/team-emily3-768x1044.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/03/team-emily3.jpg","mediaDetails":{"width":1008,"height":1370}},"title":"Head of Marketing","secondaryPhoto":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-emily2.jpg 1008w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-emily2-500x500.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-emily2-768x768.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/02/team-emily2.jpg","mediaDetails":{"width":1008,"height":1008}}}]},"teamMembers":"$2a"}],"$L80",["$","$L11",null,{"scrollTrigger":true,"darkBackground":false}],["$","$1c",null,{"fallback":null,"children":["$","$L1d",null,{"reason":"next/dynamic","children":"$L81"}]}]]}]]
