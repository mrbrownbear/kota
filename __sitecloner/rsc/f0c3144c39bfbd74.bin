roach_image__xti5i","children":["$","$L24",null,{"fill":true,"children":["$","$L20",null,{"image":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/approach.jpg 1086w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/approach-479x500.jpg 479w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/approach-768x802.jpg 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/approach.jpg","mediaDetails":{"width":1086,"height":1134}}}]}]}],["$","div",null,{"className":"Approach_mainText__y2DyK","children":["$","$L21",null,{"children":["$","div",null,{"className":"Approach_textContent__ncod1","dangerouslySetInnerHTML":{"__html":"<p>We’re not just coders who take instructions – we’re artists who take pride in being bold and draw inspiration from the wider creative world of music, film and the arts.</p>\n<p>You’ll never see us play it safe, and we especially like partnering with clients who are up for making digital waves.</p>\n<p>Sustainability is very close to our hearts, too. If your brand makes a positive impact on the environment, we’d relish in making it even bigger.</p>\n"}}]}]}]]}]}],["$","section",null,{"className":"Culture_culture__lmpEt","children":[["$","$1c",null,{"fallback":null,"children":["$","$L1d",null,{"reason":"next/dynamic","children":"$L25"}]}],["$","div",null,{"className":"container","children":[["$","p",null,{"className":"Culture_text__tkIGz","children":["$","$L19",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<em>Our culture</em> is core to everything we do."}}]}]}],["$","div",null,{"className":"Culture_buttonContainer__YAvTa","children":["$","$L10",null,{"text":"Find out more","type":"a-internal","href":"culture"}]}]]}]]}],["$","div",null,{"className":"Partners_partners__jBo8y","children":[["$","$Lf",null,{}],["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Partners_introText__3_Pu8","children":["$","$L21",null,{"children":["$"