foundations keep everything running beautifully behind the scenes.</p>\n"}}]}]}],["$","div",null,{"className":"TextImageRows_buttonContainer___PqVy","children":["$","$L1c",null,{"delay":0.3,"children":["$","$L11",null,{"href":"/service/web-development","type":"a-internal","text":"Find out more"}]}]}]]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L38",null,{"fill":true,"children":[["$","$L35",null,{"image":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/Web-Development-backrate-2.png 1224w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/Web-Development-backrate-2-500x500.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/Web-Development-backrate-2-768x768.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/Web-Development-backrate-2.png","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","2",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Wordpress & CMS."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Your team shouldn’t need a developer every time a sentence changes. We create flexible, modular content systems that make pages easy to build, edit and evolve without letting the design descend into chaos.</p>\n"}}]}]}],["$","div",null,{"className":"TextImageRows_buttonContainer___PqVy","children":["$","$L1c",null,{"delay":0.3,"children":["$","$L11",null,{"href":"/service/wordpress-cms","type":"a-internal","text":"Find out more"}]}]}]]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L38",null,{"fill":true,"children":[["$","$L35",nul