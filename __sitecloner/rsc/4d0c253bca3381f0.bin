en":[["$","h3",null,{"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 14.78 14.78","children":[["$","defs",null,{"children":["$","linearGradient",null,{"id":"d","x1":"3.54","x2":"13.98","y1":"3.54","y2":"13.99","gradientUnits":"userSpaceOnUse","children":[["$","stop",null,{"offset":"0","stopColor":"#7c41f3"}],["$","stop",null,{"offset":"1","stopColor":"#ff6eff"}]]}]}],["$","path",null,{"fill":"url(#d)","strokeWidth":"0","d":"M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"}]]}],"DK&A"]}],["$","p",null,{"children":"2023"}]]}],["$","div",null,{"className":"ProjectCard_projectImage__Nfx9I","children":[["$","div",null,{"className":"ProjectCard_imageOverlay__OCawr","children":[["$","p",null,{"className":"ProjectCard_heading__1csIW","dangerouslySetInnerHTML":{"__html":"We designed two industry-leading websites for DK&A, showcasing their services and courses."}}],["$","ul",null,{"className":"ProjectCard_tags__XdVcf","children":[[],[]]}]]}],["$","$L35",null,{"image":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2023/10/T01-Homepage-B-–-1-1-1400x788.jpg 1400w, /__external__/kota-content.b-cdn.net/app/uploads/2023/10/T01-Homepage-B-–-1-1-500x281.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2023/10/T01-Homepage-B-–-1-1-768x432.jpg 768w, /__external__/kota-content.b-cdn.net/app/uploads/2023/10/T01-Homepage-B-–-1-1.jpg 1440w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/10/T01-Homepage-B-–-1-1.jpg","mediaDetails":{"width":1440,"height":810}},"layout":"fill"}],["$","video",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2024/04/dka-thumbnail-compressed.mp4","className":"ProjectCard_video__AheFz","autoPlay":true,"muted":true,"loop":true,"preload":"none","playsInline":true}]]}]]}]]}]}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedProjects_viewAllLinkMobile__pDKQH","children":["$","$L11",null,{"type":"a-internal","text":"View all projects","color":"white","href":"/work"}]}]}]]}],["$","section",null,{"className":"FaqsList_faqsList__W3Ud0","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":[["$","div",null,{"className":"FaqsList_heading__kNT8k","children":["$","p",null,{"children":["$","$L33",null,{"children":"FAQ's"}]}]}],[["$","div","0",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What makes KOTA’s approach to web design different?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">We connect brand thinking, UX, creative design and development from the start.</span></p>\n<p><span style=\"font-weight: 400;\">That means the strategic idea doesn’t get lost between separate agencies, freelancers or internal teams. The people shaping the concept work closely with the people building it, creating a more coherent website and a much smoother process.</span></p>\n<p><!-- notionvc: 4560da57-e243-4d77-b8f6-210da83bbd62 --></p>\n<p><!-- notionvc: 4560da57-e243-4d77-b8f6-210da83bbd62 --></p>\n"}}]}]]}]}],["$","div","1",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"How long does a typical web design and development project take?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">A web design and build project can last around 12-14 weeks. But there are always ways to consider your business objectives (such as phased launches), so even if your timescales don’t work with this, it’s always worth reaching out. </span></p>\n<p><span style=\"font-weight: 400;\">A lot of it depends on the size of the site, technical complexity, content requirements and level of creative ambition. Smaller websites may move faster. Large platforms, complex integrations and immersive digital experiences will need more time. We’ll set out a clear programme before the project begins.</span></p>\n<p><!-- notionvc: 04fa8446-f45f-4b32-ba37-0a947604670a --></p>\n"}}]}]]}]}],["$","div","2",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do you do both the design and development in-house?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. We handle the full process from discovery, strategy and UX through to creative design, development, testing and launch.</span></p>\n<p><span style=\"font-weight: 400;\">Keeping design and development together helps us protect the creative ambition while making sensible technical decisions early. Fewer surprises. Better websites.</span></p>\n"}}]}]]}]}],["$","div","3",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Which CMS platforms do you use?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">We regularly build websites using WordPress, Sanity, and other flexible content management systems selected around the needs of the project.</span></p>\n<p><span style=\"font-weight: 400;\">We’ll recommend the right setup based on your team, content requirements, integrations, scalability and technical constraints rather than forcing every website into the same platform.</span></p>\n"}}]}]]}]}],["$","div","4",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What happens after the website launches?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">A website should keep evolving alongside the business, that’s why KOTA’s SiteCare is a key part of our business. We can continue supporting the website through hosting, maintenance, performance monitoring, SEO, conversion improvements, content and ongoing creative development. You can read more about SiteCare </span><a href=\"/blog/sitecare-management-website-maintenance\"><span style=\"font-weight: 400;\">here</span></a><span style=\"font-weight: 400;\">.</span> <!-- notionvc: 74ecab4c-0570-4f44-a050-ed73ed4ec96a --></p>\n<p><!-- notionvc: 74ecab4c-0570-4f44-a050-ed73ed4ec96a --></p>\n<p><!-- notionvc: 74ecab4c-0570-4f44-a050-ed73ed4ec96a --></p>\n<p><!-- notionvc: 74ecab4c-0570-4f44-a050-ed73ed4ec96a --></p>\n"}}]}]]}]}],["$","div","5",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What should I expect to pay for professional web design and development services?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">The majority of our full projects sit between £30k and £150k, but project costs will depend on the final scope of work and vary from project to project. We generally have a minimum website project size of £25k and prefer to agree a fixed cost with agreed milestone payments.</span><br />\n<!-- notionvc: 8ec0fece-0a23-4d4e-9183-d2786b5a4646 --></p>\n<p><!-- notionvc: 8ec0fece-0a23-4d4e-9183-d2786b5a4646 --></p>\n"}}]}]]}]}]]]}]]}],"$L36","$L37"]}]]
