p/uploads/2024/05/hero-500x281.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2024/05/hero-768x432.png 768w, /__external__/kota-content.b-cdn.net/app/uploads/2024/05/hero-1536x865.png 1536w, /__external__/kota-content.b-cdn.net/app/uploads/2024/05/hero-2048x1153.png 2048w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/05/hero.png","mediaDetails":{"width":2448,"height":1378}},"lazy":false,"priority":"high","sizes":"100vw"}],false]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1c",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Florence, a vibrant online marketplace, connects care professionals with healthcare providers through web and mobile apps in the UK, France, and Canada. With a mission of streamlining healthcare staffing and management and ambitions to expand into Germany and beyond, they knew they needed a digital makeover. Enter KOTA.</p>\n<p>The challenge was to transform Florence’s brand and digital presence from top to bottom. We needed to craft a fresh brand strategy, redesign their website, and establish detailed, actionable brand guidelines.</p>\n<p>Our mission? Enhance user experience, align their digital presence with Florence’s identity, and set the stage for explosive global growth.</p>\n<p><!-- notionvc: 671ce3e8-0182-459b-9988-ffb18696ebfd --></p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1c",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"Healthcare"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"London, UK"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1c",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":["$","$L1c",null,{"delay":0.3,"children":["$","a",null,{"href":"https://www.florence.co.uk/","target":"_blank","style":{"backgroundColor":"#7049d1","borderColor":"#7049d1"},"children":[["$","span",null,{"className":"$undefined","children":"Visit site"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 12.6 12.6","className":"Intro_buttonArrow___9UE0","children":[["$","path",null,{"fill":"#fff","d":"M11.85 12.6c-.41 0-.75-.34-.75-.75V1.5H.75C.34 1.5 0 1.16 0 .75S.34 0 .75 0h11.1c.41 0 .75.34.75.75v11.1c0 .41-.34.75-.75.75z"}],["$","path",null,{"fill":"#fff","d":"M1.13 12.21c-.19 0-.38-.07-.53-.22a.754.754 0 010-1.06L11.32.22c.29-.29.77-.29 1.06 0 .29.29.29.77 0 1.06L1.66 11.99c-.15.15-.34.22-.53.22z"}]]}]]}]}]}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"$undefined","data-margin":"default","children":[false,["$","div",null,{"className":"$undefined","children":["$","$L1f",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"fullPageWidth","marginBottom":"default","loop":{"mediaItemUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/05/Florence-1.mp4"},"fullVideo":null}}]}]]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1c",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$20"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGall