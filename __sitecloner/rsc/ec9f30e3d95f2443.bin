:"Testimonials_heading__uq3W3","children":["$","$L1a",null,{"children":["$","span",null,{"children":"What our clients say"}]}]}],["$","div",null,{"className":"Testimonials_testimonialDesktop__yzrb3","children":["$","$L26",null,{"testimonials":[{"text":"KOTA just built us a shiny new eCommerce website on Shopify and we couldn't be happier with it. We know that, thanks to KOTA, we're going to be able to convert more sales and introduce more customers to the wonderful world of flavoured coffee.","backgroundColor":"#f6e6cd","name":"Little's Coffee","speciality":null,"button":{"title":"View project","url":"/work/littles-coffee/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/06/svgexport-2-1.svg","mediaDetails":{"width":282,"height":81}}},{"text":"KOTA is the best! Thanks team for the great partnership!","backgroundColor":"#c1b7f0","name":"Pison","speciality":null,"button":{"title":"View project","url":"/work/pison/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/05/pison-logo.svg","mediaDetails":{"width":120,"height":94}}},{"text":"We have worked with Kota on three Jamie Oliver books. 5 Ingredients, Jamie Cooks Italy and now the very exciting VEG campaign. They have brought each book to life for digital advertising and out of home in really creative and innovative ways. It’s also a joy to work with such a dedicated and sound team, can’t wait to work with them again.","backgroundColor":"#e7b6d7","name":"Jamie Oliver","speciality":null,"button":{"title":"View project","url":"/work/jamie-oliver-5-ingredients/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/10/Jamie-oliver.svg","mediaDetails":{"width":0,"height":0}}}]}]}]]}],["$","div",null,{"className":"Testimonials_testimonialMobile__OUUvi","children":["$","$L26",null,{"testimonials":"$27"}]}]]}],"$L34","$L35"]}]]
