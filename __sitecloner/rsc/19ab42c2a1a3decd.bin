16:T79f,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"/landing-page/media-entertainment/","url":"/media-entertainment","name":"Media & Entertainment - KOTA","isPartOf":{"@id":"/#website"},"datePublished":"2024-06-18T11:19:57+00:00","dateModified":"2025-05-27T07:03:08+00:00","description":"Media & entertainment sites should feel like an experience. We design immersive, award-winning websites that captivate audiences and keep them coming back.","breadcrumb":{"@id":"/media-entertainment#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["/media-entertainment"]}]},{"@type":"BreadcrumbList","@id":"/media-entertainment#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"/"},{"@type":"ListItem","position":2,"name":"Media &#038; Entertainment"}]},{"@type":"WebSite","@id":"/#website","url":"/","name":"KOTA","description":"","publisher":{"@id":"/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"/#organization","name":"KOTA","alternateName":"KOTA creative","url":"/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"/#/schema/logo/image/","url":"/app/uploads/2024/11/Logo-Profile.png","contentUrl":"/app/uploads/2024/11/Logo-Profile.png","width":1080,"height":1080,"caption":"KOTA"},"image":{"@id":"/#/schema/logo/image/"},"sameAs":["https://www.facebook.com/kotacreative/","https://x.com/kotacreative"]}]}27:{"title":"Get in touch","url":"/work/records-bars/","target":""}
