UZd","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"Testimonials_heading__uq3W3","children":["$","$L18",null,{"children":["$","span",null,{"children":"What our clients say"}]}]}],["$","div",null,{"className":"Testimonials_testimonialDesktop__yzrb3","children":["$","$L24",null,{"testimonials":[{"text":"The design of our website is just incredible. The site’s bounce rate has decreased while time spent on the platform has increased.","backgroundColor":"#f6e6cd","name":"Rosie Johnstone","speciality":"Head of Marketing & Communications, Rocket Leisure.","button":{"title":"Get in touch","url":"/work/records-bars/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2024/06/records-bars.svg","mediaDetails":{"width":425,"height":425}}},{"text":"I have been involved in making around 60+ hospitality websites with small agencies and massive agencies, and this has been by far the best process from start to finish. The website looks great, the back end is great, the development is top notch, project manager Maja was on top of everything, SEO is looking spot on. Went live without a hitch.","backgroundColor":"#c1b7f0","name":"Simmons Bars","speciality":null,"button":{"title":"Get in touch","url":"/contact/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2024/06/simmons.svg","mediaDetails":{"width":212,"height":51}}},{"text":"Beyond the aesthetics, the site is incredibly functional. The CMS KOTA implemented gives us the flexibility and control we need to keep our content fresh and relevant. The intuitive navigation and clear user journeys have significantly improved the overall user experience, and the website is now a crucial asset in our growth strategy. We couldn't be happier with the results.","backgroundColor":"#efb2d9","name":"Jenny Frame","speciality":"Marketing Manager","button":{"title":"Get in touch","url":"/contact/","target":""},"logo":{"altText":"","srcSet":"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2024/06/incentive-games.png 640w, /__external__/__external__/kota-content.b-cdn.net/app/uploads/2024/06/incentive-games-500x303.png 500w","sourceUrl":"/__external__/__external__/kota-content.b-cdn.net/app/uploads/2024/06/incentive-games.png","mediaDetails":{"width":640,"height":388}}}]}]}]]}],["$","div",null,{"className":"Testimonials_testimonialMobile__OUUvi","children":["$","$L24",null,{"testimonials":"$25"}]}]]}],"$L32","$L33"]}]]
