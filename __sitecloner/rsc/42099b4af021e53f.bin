":"/__external__/kota-content.b-cdn.net/app/uploads/2023/10/saatchi.svg","alt":""}]}]]}]}]}]]}]]}],["$","section",null,{"className":"Testimonials_testimonials__AMUEx","children":[["$","$Lf",null,{}],["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"Testimonials_heading__k0Yyf","children":["$","$L2b",null,{"children":["$","span",null,{"children":"What our clients say"}]}]}],["$","div",null,{"className":"Testimonials_testimonialDesktop__v5dZX","children":["$","$L2c",null,{"testimonials":[{"text":"\"It was our brand positioning work that really made everything click. KOTA were empathetic, patient, flexible, quick, and, most importantly, incredibly talented with brand positioning, visual identity, and digital experiences. I've already recommended them twice!\"","backgroundColor":"#a8e1ec","name":"Shanice Daeche","speciality":"CMO","button":{"title":"View project","url":"/work/florence/index.html/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2025/05/Florence-Logo-White.svg","mediaDetails":{"width":230,"height":68}}},{"text":"\"Beyond the aesthetics, the website is incredibly functional. The CMS gives us the flexibility and control we need to keep our content fresh and relevant, and they have significantly improved the website’s UX. We couldn't be happier!\"","backgroundColor":"#c4b5f3","name":"Jenny Frame","speciality":"Marketing Manager","button":{"title":"View project","url":"/work/incentive-games/","target":""},"logo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2024/06/incentive-games.png 640w, /__external__/kota-content.b-cdn.net/app/uploads/2024/06/incentive-games-500x303.png 500w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/06/incentive-games.png","mediaDetails":{"width":640,"height":388}}},{"text":"\"We needed something that would blur the lines between web, technology, and cinema, and reflect who we are: an artist-led, tech-forward company creating work at the highest level. From the very first conversations, KOTA understood that vision. They transformed the brief beyond what we had imagined. It’s no exaggeration to say the final product redefines what a website can be.\"","backgroundColor":"#f8e5cb","name":"Shaun Obanion","speciality":"PR Manager of Universal Production Partners","button":{"title":"View project","url":"/work/upp/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2025/08/UPP-logo.svg","mediaDetails":{"width":64,"height":64}}},{"text":"\"Beyond the initial launch, KOTA have continued to support us over the past 12 months with ongoing SEO, helping us build visibility and performance in a really strategic, considered way. Their team are creative, knowledgeable, responsive, and genuinely invested in delivering long-term value, not just a one-off project. We wouldn’t hesitate to recommend KOTA to any brand looking for a smart, design-led agency that truly understands digital growth.\"","backgroundColor":"#d7e1d3","name":"Bianca Cristescu  ","speciality":"Key Account Director, ISI Global","button":{"title":"View project","url":"/work/isi-global/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2025/04/ISI-Logo-White.svg","mediaDetails":{"width":241,"height":34}}},{"text":"\"As a design agency ourselves, handing responsibility for our web re-design to another creative agency needed to be well considered. We were immediately impressed by their designs and their interpretation of our brief. Nice bunch of people to work with too!\"","backgroundColor":"#efb2d9","name":"Laurie Bushe","speciality":"Head of Marketing","button":{"title":"View project","url":"/work/tangerine/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/tangerine-logo.svg","mediaDetails":{"width":233,"height":53}}},{"text":"\"KOTA’s ideas were fresh and exciting, and their ability as a one-stop-shop for Branding, Tone of Voice, Copywriting, Website design and Development meant we were able to do the whole process with them. Amazing creative agency.\"","backgroundColor":"#a8e1ec","name":"Finn Bruce","speciality":"Floan","button":{"title":"View Project","url":"/work/floan/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/Floan-Logo-Black.svg","mediaDetails":{"width":0,"height":0}}}]}]}]]}],["$","div",null,{"className":"Testimonials_testimonialMobile__gCvdw","children":["$","$L2c",null,{"testimonials":"$2d"}]}]]}],["$","div",null,{"className":"Articles_articles__Wcz2C","children":[["$","$Lf",null,{}],["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Articles_heading__zNRl8","children":[["$","p",null,{"children":["$","$L1f",null,{"children":"Latest articles"}]}],["$","$L1f",null,{"children":["$","$L10",null,{"type":"a-internal","href":"/blog","text":"View our blog","color":"white"}]}]]}],["$","$L26",null,{"children":["$","div",null,{"className":"Articles_articlesList__CXW8a","children":[[["$","$L13","7659",{"href":"/blog/branding-inspiration-brand-design-trends-for-2026","data-animation":"grid-item","children":["$","article",null,{"className":"Articles_article__3ZS4Y","children":[["$","figure",null,{"className":"Articles_image__Cvgsi","children":["$","$L27",null,{"image":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2025/11/brand-trend-2026.png 1400w, /__external__/kota-content.b-cdn.net/app/uploads/2025/11/brand-trend-2026-500x281.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2025/11/brand-trend-2026-768x432.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2025/11/brand-trend-2026.png","mediaDetails":{"width":1400,"height":787}}}]}],["$","div",null,{"className":"Articles_text__HhO2L","children":[["$","p",null,{"class