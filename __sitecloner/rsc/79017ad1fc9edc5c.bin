22:["$","section",null,{"className":"Intro_intro__B7xXJ","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","span",null,{"children":"Brand foundations for businesses ready to grow."}]}]}],["$","div",null,{"className":"Intro_text__4DPtt prose","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>As Dolly Parton once said: “Find out who you are and do it on purpose.” We’ll give your brand the clarity, conviction, and creativity to do exactly that, then build the identity to prove it.</p>\n"}}]}]}]]}]}]
23:["$","section",null,{"className":"TextImageRows_textImageRows__lOU02","children":["$","div",null,{"className":"container","children":[[["$","div","0",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Brand strategy."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Strong brands start with clear decisions. We find what makes your brand worth choosing, then turn it into positioning, messaging and strategic direction your team can actually use.</p>\n"}}]}]}],["$","div",null,{"className":"TextImageRows_buttonContainer___PqVy","children":["$","$L1c",null,{"delay":0.3,"children":["$","$L11",null,{"href":"/service/brand-strategy","type":"a-internal","text":"Find out more"}]}]}]]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L39",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/brand-strategy-V2.mp4","layout":"fill"}]]}]}]]}],["$","div","1",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Brand identity design."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Everything earns its place. We create brand identity systems with intent behind every decision, built to be recognisable, flexible, and credible wherever you show up.</p>\n"}}]}]}],["$","div",null,{"className":"TextImageRows_buttonContainer___PqVy","children":["$","$L1c",null,{"delay":0.3,"children":["$","$L11",null,{"href":"/service/brand-identity-design","type":"a-internal","text":"Find out more"}]}]}]]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L39",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/Brand-To-Web-Bankrate-V2.mp4","layout":"fill"}]]}]}]]}],["$","div","2",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Tone of voice."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>In a world overrun by AI-sameness, a unique brand voice is more important than ever. We’ll help you sound unmistakably like you, with a voice your team can write from confidently.</p>\n"}}]}]}],["$","div",null,{"className":"TextImageRows_buttonContainer___PqVy","children":["$","$L1c",null,{"delay":0.3,"children":["$","$L11",null,{"href":"/service/tone-of-voice","type":"a-internal","text":"Find out more"}]}]}]]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L39",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/tone-of-voice-V2.mp4","layout":"fill"}]]}]}]]}]],["$","div",null,{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Audit your brand in minutes"}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",n