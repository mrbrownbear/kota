18:T809,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"/service/brand-strategy-and-identity/index.html/","url":"/service/brand-strategy-and-identity/index.html/","name":"Global Branding Agency in London | Strategy & Identity | KOTA","isPartOf":{"@id":"/index.html#website"},"datePublished":"2023-11-03T14:43:04+00:00","dateModified":"2026-09-22T13:01:50+00:00","description":"Dolly Parton once said: “Find out who you are and do it on purpose.” Discover KOTA's brand strategy, positioning, tone, and identity design services.","breadcrumb":{"@id":"/service/brand-strategy-and-identity/index.html/#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["/service/brand-strategy-and-identity/index.html/"]}]},{"@type":"BreadcrumbList","@id":"/service/brand-strategy-and-identity/index.html/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"/index.html"},{"@type":"ListItem","position":2,"name":"Brand strategy &#038; identity"}]},{"@type":"WebSite","@id":"/index.html#website","url":"/index.html","name":"KOTA","description":"","publisher":{"@id":"/index.html#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/index.html?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"/index.html#organization","name":"KOTA","alternateName":"KOTA creative","url":"/index.html","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"/index.html#/schema/logo/image/","url":"/index.htmlapp/uploads/2024/11/Logo-Profile.png","contentUrl":"/index.htmlapp/uploads/2024/11/Logo-Profile.png","width":1080,"height":1080,"caption":"KOTA"},"image":{"@id":"/index.html#/schema/logo/image/"},"sameAs":["https://www.facebook.com/kotacreative/","https://x.com/kotacreative"]}]}29:{"title":"View project","url":"/work/florence/index.html/","target"