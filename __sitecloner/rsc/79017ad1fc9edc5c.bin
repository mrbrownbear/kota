2023/11/results-light-1400x762.jpg 1400w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-2000x1089.jpg 2000w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-500x272.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-768x418.jpg 768w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-1536x836.jpg 1536w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-2048x1115.jpg 2048w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light.jpg","mediaDetails":{"width":2244,"height":1222}}},{"mainStatistic":"83.14%","description":"increase in sales after 1 year.","button":{"title":"Wogan Coffee","url":"/work/wogan-coffee/","target":""},"brandLogo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2024/05/wogan-logo.svg","mediaDetails":{"width":0,"height":0}},"brandVisual":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2025/04/Wogan-Image.png 1354w, /__external__/kota-content.b-cdn.net/app/uploads/2025/04/Wogan-Image-500x295.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2025/04/Wogan-Image-768x453.png 768w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2025/04/Wogan-Image.png","mediaDetails":{"width":1354,"height":799}},"backgroundImage":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-1400x762.jpg 1400w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-2000x1089.jpg 2000w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-500x272.jpg 500w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-768x418.jpg 768w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-1536x836.jpg 1536w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light-2048x1115.jpg 2048w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/results-light.jpg","mediaDetails":{"width":2244,"height":1222}}}]}]]}],["$","$L25",null,{"data":{"heading":"Our brand process","subheading":"Every stage is built to uncover what makes you different, sharpen how you communicate it, and turn it into a system that works in the real world.","enable":true,"blocks":[{"heading":"Discovery","image":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/workflow4.jpg","mediaDetails":{"width":426,"height":426}},"text":"We start by building a clear picture of your world today, where you want to go, and what stands in the way. Through desk research and conversations with key stakeholders, we uncover the opportunities for your brand and align everyone around a shared direction.\r\n","duration":"2 weeks","weekNumber":1,"workInvolved":[{"item":"Stakeholder interviews"},{"item":"Desk research"},{"item":"Brand audit"},{"item":"Competitor & industry analysis"}]},{"heading":"Brand workshops","image":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/workflow5.jpg","mediaDetails":{"width":426,"height":426}},"text":"Next, we’ll run collaborative workshops to unpack our findings, challenge assumptions, and explore the foundations of the brand together. Positioning, perception, personality, audience, ambition. The stuff that actually shapes how a brand feels.","duration":"3-5 hours","weekNumber":3,"workInvolved":[{"item":"Deepdive sessions"},{"item":"Playback presentations"}]},{"heading":"Brand strategy","image":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/workflow3.jpg","mediaDetails":{"width":426,"height":426}},"text":"This is where the direction gets defined. We’ll build a differentiated brand strategy rooted in what makes you valuable, memorable and hard to copy. Your positioning, messaging, mission, values and ‘Big Idea’ all start to come together here into a strategic foundation your marketing, website, sales and design can actually build from.","duration":"3 weeks","weekNumber":4,"workInvolved":[{"item":"Vision & mission"},{"item":"Brand positioning"},{"item":"Value propositions"},{"item":"Brand & product architecture"},{"item":"Brand personality"},{"item":"Brand values"}]},{"heading":"Tone of voice & copywriting","image":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/workflow1.jpg","mediaDetails":{"width":426,"height":426}},"text":"A strong brand should sound as distinctive as it looks. We’ll define how your brand speaks across every touchpoint, from website copy and campaigns to sales decks and social posts. That includes voice principles, personality traits, vocabulary, and practical guidance your team can actually use. Clear. Consistent. Human.","duration":"2 weeks","weekNumber":4,"workInvolved":[{"item":"Tone of voice pillars"},{"item":"Glossary & vocabulary"},{"item":"How-to writing guides"}]},{"heading":"Logo & icon design","image":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/workflow2.jpg","mediaDetails":{"width":426,"height":426}},"text":"Whether we’re refining an existing identity or starting from scratch, we design logo and icon marks with motion baked into them from the start. Every shape, decision and detail should earn its place, based on the brand positioning. The result is a brand mark that feels distinctive and built to last.","duration":"2 weeks","weekNumber":6,"workInvolved":[{"item":"Logo design"},{"item":"Icon design"},{"item":"Motion design"},{"item":"Asset folder delivery"}]},{"heading":"Brand identity","image":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/workflow4.jpg","mediaDetails":{"width":426,"height":426}},"text":"Now the brand starts to come to life visually. We’ll explore typography, colour, layout systems, imagery and graphic styles across multiple creative routes before developing a chosen direction further. The goal is a visual system that feels cohesive, recognisable and flexible enough to grow with you.","duration":"3 weeks","weekNumber":8,"workInvolved":[{"item":"Typography"},{"item":"Colour palette"},{"item":"Layout styles"},{"item":"Brand visuals"},{"item":"Imagery usage"},{"item":"Touchpoint examples"},{"item":"Motion design"}]},{"heading":"Online brand guidelines","image":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/workflow5.jpg","mediaDetails":{"width":426,"height":426}},"text":"Finally, we bring everything together into one clear, usable system. Your strategy, tone of voice and visual identity will live inside an online brand guidelines platform that’s easy to update, share and apply across teams. A practical, accessible toolkit with downloadable assets.","duration":"1 week","weekNumber":11,"workInvolved":[{"item":"Verbal guidelines"},{"item":"Visual guidelines"},{"item":"Layout guidelines"},{"item":"Touchpoint examples"},{"item":"Downloadable assets"}]}]}}],["$","section",null,{"className":"Testimonials_testimonials__J0bdm","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"Testimonials_heading__q4vc3","children":["$","$L1a",null,{"children":["$","span",null,{"children":"What our clients say."}]}]}],["$","div",null,{"className":"Testimonials_testimonialDesktop__XClcG","children":["$","$L26",null,{"testimonials":[{"text":"\"It was our brand positioning work that really made everything click. KOTA were empathetic, patient, flexible, quick, and, most importantly, incredibly talented with brand positioning, visual identity, and digital experiences. I've already recommended them twice!\"","backgroundColor":"#c4b5f3","name":"Shanice Daeche","speciality":"CMO","button":{"title":"View project","url":"/work/florence/index.html/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2025/05/Florence-Logo-White.svg","mediaDetails":{"width":230,"height":68}}},{"text":"\"KOTA helped us achieve our vision. Through creative idea generation, hands-on guidance and support, to professional project management, they were able to deliver the type of company website that represents our products and services, and most importantly, our brand. We are more than satisfied with the results.\"","backgroundColor":"#a8e1ec","name":"Robert Baird, Collidr","speciality":"View our work","button":null,"logo":null},{"text":"“Working with KOTA has been a fantastic experience from start to finish. They partnered with us to design and launch our new brand and website, and the result has exceeded our expectations: modern, confident, and perfectly aligned with who we are as a business.\"","backgroundColor":"#efb2d9","name":"Bianca Cristescu","speciality":"Key Account Director","button":{"title":"View our work","url":"/index.htmlwork/","target":""},"logo":{"altText":"","srcSet":null,"sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2025/04/ISI-Logo-White.svg","mediaDetails":{"width":241,"height":34}}},{"text":"\"After a personal recommendation, we brought KOTA in to evolve our brand from top to bottom. They took the time to understand not just what we did as a company, but the people involved and brought that to life through our updated TOV and a refreshed look that matched the work we've been doing for the last two years. If you want your brand to reflect your ambition, this is the agency to do it”","backgroundColor":"#d7e1d3","name":"Jake Stevens, Ziipline","speciality":"View our work","button":{"title":"Work","url":"/index.htmlwork/","target":""},"logo":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/Ziipline_Logo_Coral_RGB-8-1400x354.png 1400w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/Ziipline_Logo_Coral_RGB-8-2000x505.png 2000w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/Ziipline_Logo_Coral_RGB-8-500x126.png 500w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/Ziipline_Logo_Coral_RGB-8-768x194.png 768w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/Ziipline_Logo_Coral_RGB-8-1536x388.png 1536w, /__external__/kota-content.b-cdn.net/app/uploads/2023/11/Ziipline_Logo_Coral_RGB-8-2048x517.png 2048w","sourceUrl":"/__external__/kota-content.b-cdn.net/app/uploads/2023/11/Ziipline_Logo_Coral_RGB-8-2560x647.png","mediaDetails":{"width":3000,"height":758}}}]}]}]]}],["$","div",null,{"className":"Testimonials_testimonialMobile__B0_Aa","children":["$","$L26",null,{"testimonials":"$27"}]}]]}],["$","section",null,{"className":"RelatedPosts_relatedPosts__xfLkb","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedPosts_headingOuter__r3TEg","children":[["$","p",null,{"className":"RelatedPosts_heading__3kOeH","children":["$","$L35",null,{"children":"Related Articles"}]}],["$","div",null,{"className":"RelatedPosts_viewAllLinkDesktop__db363","children":["$","$L35",null,{"delay":0.15,"children":["$","$L11",null,{"type":"a-internal","text":"View all articles","color":"white","href":"/blog"}]}]}]]}]}],["$","$L36",null,{"children":["$","div",null,{"className":"container","children":[["$","$L14","7546",{"className":"BlogPostCard_post__fNGbL BlogPostCard_small__j18h2","href":"/blog/brand-first-vs-dev-first-what-actually-sets-kota-apart-and-why-it-matters","data-animation":"grid-item","children":[["$","div",null,{"className":"BlogPostCard_postImage__Q4k_I","children":[["$","div",null,{"className":"BlogPostCard_tags__RKboe","children":[false,[["$","span","Expertise",{"className":"BlogPostCard_tag__Dv5HS","children":"Expertise"}]]]}],["$","$L21",null,{"image":{"altText":"","srcSet":"/__external__/kota-content.b-cdn.net/app/uploads/2025/10/Rebel-against-boring.png 1400w, /__external__/kota-content.b-cdn.net/app/uploads/2025/10/Rebel-against-boring-500